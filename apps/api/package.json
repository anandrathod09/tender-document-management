{
  "name": "@tdm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "db:create": "tsx src/db/create-databases.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:demo": "tsx src/db/demo.ts",
    "migrate:tms": "tsx src/db/migrate-from-tms.ts"
  },
  "dependencies": {
    "@tdm/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.12"
  }
}
