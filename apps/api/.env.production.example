# Settings for the live server. Copy to apps/api/.env on the server, fill in,
# then: chmod 600 apps/api/.env. Never commit the filled-in file.
# The API refuses to start with unsafe values (see deploy/README.md).

NODE_ENV=production
PORT=4000
# nginx on the same server is the only thing that talks to the API.
TRUST_PROXY=loopback

# Your domain. Clients live at <slug>.<BASE_DOMAIN>, the owner panel at owner.<BASE_DOMAIN>.
BASE_DOMAIN=yourdomain.com
OWNER_SUBDOMAIN=owner
PUBLIC_URL_TEMPLATE=https://{slug}.yourdomain.com

# MySQL (the database user created in deploy/README.md, step 4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tdm
DB_PASSWORD=
DB_NAME=tender_manager

# Two different random values: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Encrypts authenticator-app keys. Never change it after going live.
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

# Uploaded files. "local": a folder on this server (backed up by deploy/scripts/backup.sh).
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/tender-manager/storage
# Or "s3": a private bucket (Cloudflare R2, DigitalOcean Spaces, Amazon S3, Backblaze B2).
# Moving later: fill these in, run npm run storage:to-s3 -- --from /var/lib/tender-manager/storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=tender-manager-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

RUN_WORKER=true

# Email (SMTP from your email provider). Without it, invitations and password
# resets are not sent: admins would have to copy invitation links by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
PRODUCT_NAME=Tender Manager

LOG_LEVEL=info

# Billing: see apps/api/.env.example for every setting.
BILLING_SELLER_NAME=Your Company Pvt Ltd
BILLING_SELLER_ADDRESS=Your address, City, State PIN
BILLING_SELLER_GSTIN=
BILLING_SELLER_STATE_CODE=27
BILLING_SUPPORT_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
