# Copy to .env for local development. Never commit the filled-in file.

NODE_ENV=development
PORT=4000

# Base domain clients live under: <slug>.<BASE_DOMAIN>
# Local development uses *.localhost, which browsers resolve to this computer.
BASE_DOMAIN=localhost
OWNER_SUBDOMAIN=owner
# Link sent in invitation emails. {slug} is replaced with the client's subdomain.
PUBLIC_URL_TEMPLATE=http://{slug}.localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tender_saas_dev
TEST_DB_NAME=tender_saas_test

# Random value of at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Key for secrets stored in the database (authenticator app keys), at least 32
# characters. If empty, one is derived from JWT_ACCESS_SECRET; set it before going
# live and never change it afterwards (people would have to set up two-step login again).
ENCRYPTION_KEY=
# true when served over HTTPS (staging, production)
COOKIE_SECURE=false

# Uploaded files (local disk in development; an S3-compatible bucket in production).
STORAGE_DIR=storage
# Run the background job worker (emails, compliance PDFs, deadline rules) in the API process.
RUN_WORKER=true

# Email over SMTP (Amazon SES, Brevo and Postmark all provide SMTP).
# Leave SMTP_HOST empty to keep emails locally instead of sending them: they are
# printed in the console and saved to STORAGE_DIR/mail-outbox, viewable at
# http://owner.localhost:5173/api/dev/mail (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=no-reply@example.com
PRODUCT_NAME=Tender Manager

LOG_LEVEL=info

# --- Billing (placeholders until your details are final) ---
# Printed on GST invoices as the seller.
BILLING_SELLER_NAME=Your Company Pvt Ltd
BILLING_SELLER_ADDRESS=Your address, City, State PIN
BILLING_SELLER_GSTIN=
# Two-digit GST state code of the seller (27 = Maharashtra).
BILLING_SELLER_STATE_CODE=27
# Shown to clients for renewals when online payment is off, and on invoices.
BILLING_SUPPORT_EMAIL=
GST_RATE_PERCENT=18
# true: plan prices already include GST; false: GST is added on top.
PRICES_INCLUDE_GST=false
INVOICE_PREFIX=INV
# Days after the paid period ends before a client counts as expired.
BILLING_GRACE_DAYS=7
# Suspend expired clients automatically (false = send reminders only).
BILLING_AUTO_SUSPEND=false
# Razorpay (Dashboard -> Settings -> API keys / Webhooks). Online payment shows only
# when the key ID and secret are set. Use test keys (rzp_test_...) until going live.
# Webhook URL: https://<your domain>/api/billing/webhook  (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
