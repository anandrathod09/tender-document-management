{
  "name": "tender-document-management",
  "private": true,
  "description": "Multi-tenant tender management platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api",
    "format": "prettier --write \"apps/*/src/**/*.{ts,vue,css}\" \"apps/api/test/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "db:create": "npm run db:create -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api --",
    "db:demo": "npm run db:demo -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
